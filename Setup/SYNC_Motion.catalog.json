[
  {
    "id": "VRAMWIZ.SYNC_Motion",
    "name": "音楽同期アニメーション",
    "type": "フィルタプラグイン",
    "summary": "音楽に合わせて画像を動かすフィルター",
    "description": "https://raw.githubusercontent.com/vramwiz/SYNC_Motion/main/README.md",
    "author": "VRAMの魔術師",
    "repoURL": "https://github.com/vramwiz/SYNC_Motion/",
    "licenses": [
      {
        "type": "不明",
        "isCustom": true,
        "copyrights": [],
        "licenseBody": ""
      }
    ],
    "tags": [
      "音楽同期",
      "アニメーション",
      "MIDI"
    ],
    "dependencies": [],
    "images": [],
    "installer": {
      "source": {
        "type": "githubRelease",
        "owner": "vramwiz",
        "repo": "SYNC_Motion",
        "pattern": "^SYNC_Motion\\.zip$",
        "github": {
          "owner": "vramwiz",
          "repo": "SYNC_Motion",
          "pattern": "^SYNC_Motion\\.zip$"
        }
      },
      "install": [
        {
          "action": "download"
        },
        {
          "action": "extract"
        },
        {
          "action": "copy",
          "from": "{tmp}/SYNC_Motion",
          "to": "{pluginsDir}/SYNC_Motion"
        }
      ],
      "uninstall": [
        {
          "action": "delete",
          "path": "{pluginsDir}/SYNC_Motion"
        }
      ]
    },
    "version": []
  }
]
